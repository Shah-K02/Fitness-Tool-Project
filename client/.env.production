# Base URL prepended to API requests in the production build.
# Empty = same origin: the Express server serves this build and the API
# together, which is the default deployment. If you host the client
# separately (e.g. on a static host), set this in the build environment to
# the API's URL, e.g. REACT_APP_API_BASE_URL=https://api.example.com, and add
# the client's origin to CORS_ORIGINS on the server.
REACT_APP_API_BASE_URL=
GENERATE_SOURCEMAP=false
# Keep all scripts in files so the server's Content-Security-Policy
# (script-src 'self') can block inline scripts.
INLINE_RUNTIME_CHUNK=false
