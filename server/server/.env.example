# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
# "production" serves the built client and turns on production checks.
NODE_ENV=development
PORT=8081

# --- Database (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=fitness_app
DB_PASS=
DB_NAME=fitness_app
# Set to true for managed databases that require TLS (most do).
DB_SSL=false
# Optional path to the host's CA certificate bundle when DB_SSL=true.
# DB_SSL_CA=/etc/ssl/certs/db-ca.pem

# --- Auth ---
# Long random string, at least 32 characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Third-party APIs ---
# RapidAPI key with ExerciseDB and "YouTube Search and Download" subscriptions.
REACT_APP_RAPID_API_KEY=
# USDA FoodData Central key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# --- Optional ---
# Comma-separated origins allowed to call the API from another domain.
# Leave empty when this server also serves the client (the default setup).
# CORS_ORIGINS=https://your-frontend.example.com
# Proxies in front of the app, for correct client IPs in rate limiting.
# Defaults to 1 in production (Render, Railway, Heroku, a single nginx).
# TRUST_PROXY=1
# Where uploaded post images are stored. Use a persistent disk in production.
# UPLOADS_DIR=uploads
